#!/usr/bin/env bash
# Start the three-role BioClaw prototype using an existing .env.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT/.env"
BUILD=true

usage() {
  cat <<'EOF'
Usage: ./scripts/bioclaw-up [--no-build]

Start Conductor, AssistantOC, and ReasonerOC with Docker Compose.
Configure .env and the MORK connection first; see docs/setup.md.

  --no-build  Use an existing compatible bioclaw:phase0 image.
  --help      Show this help.

The launcher reads .env and never replaces it.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --no-build) BUILD=false ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown option: %s\n' "$arg" >&2; usage >&2; exit 2 ;;
  esac
done

if [[ ! -f "$ENV_FILE" ]]; then
  printf 'Missing %s. Copy .env.example to .env and configure it; see docs/setup.md.\n' "$ENV_FILE" >&2
  exit 1
fi

command -v docker >/dev/null || {
  printf 'Docker is required; see docs/setup.md.\n' >&2
  exit 1
}
docker compose version >/dev/null

cd "$ROOT"
compose_args=(up -d)
if [[ "$BUILD" == true ]]; then
  compose_args+=(--build)
fi
compose_args+=(conductor assistant-oc reasoner-oc)
docker compose --env-file "$ENV_FILE" "${compose_args[@]}"

printf 'Inspect startup with: docker compose ps\n'
printf 'Then run: ./scripts/bioclaw-sentinel-check.sh\n'
