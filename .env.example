# Symbolic CLI configuration reference.
# The CLI does not load this file automatically. Pass these values as flags.
# See docs/commands.md for examples.
BIOCLAW_MORK_URL=http://localhost:8027
MORK_NAMESPACE=auto
BIOCLAW_SCHEMA=/absolute/path/to/hsa_schema_config.yaml
BIOCLAW_SCHEMA_POLICY=config/schema_roles.yaml
BIOCLAW_REASONING_FILE=config/reasoning.yaml
